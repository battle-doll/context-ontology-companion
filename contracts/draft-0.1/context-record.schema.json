{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft.1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^ctx_[A-Za-z0-9_-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^prj_[A-Za-z0-9_-]+$"
    },
    "kind": {
      "enum": [
        "Decision",
        "Goal",
        "Requirement",
        "Constraint"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "subject": {
      "$ref": "#/$defs/entity"
    },
    "predicate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "object": {
      "$ref": "#/$defs/value"
    },
    "origin": {
      "enum": [
        "user_asserted",
        "document_observed",
        "model_inferred"
      ]
    },
    "extraction_method": {
      "enum": [
        "direct_user_input",
        "quoted_excerpt",
        "rule_based",
        "model_generated"
      ]
    },
    "verification": {
      "enum": [
        "unverified",
        "source_checked"
      ]
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "valid_until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "disputed",
        "superseded",
        "retracted"
      ]
    },
    "supersedes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^ctx_[A-Za-z0-9_-]+$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "revision"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "project_id",
    "kind",
    "statement",
    "subject",
    "predicate",
    "object",
    "origin",
    "extraction_method",
    "verification",
    "review",
    "sources",
    "valid_from",
    "valid_until",
    "recorded_at",
    "status",
    "supersedes"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/context-companion/draft-0.1/context-record.schema.json",
  "title": "ContextRecord draft; output-only server-managed record",
  "description": "Draft design contract. Server authorization, approval, temporal order, references and cycles require additional checks.",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "active",
              "disputed",
              "superseded",
              "retracted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "const": "user_approved"
              },
              "approved_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "approval_method": {
                "enum": [
                  "authenticated_ui",
                  "verified_host_attestation"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "rejected"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "approved_at": {
                "type": "null"
              },
              "approval_method": {
                "const": "none"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^src_[A-Za-z0-9_-]+$"
        },
        "kind": {
          "enum": [
            "user_excerpt",
            "document_excerpt",
            "model_suggestion",
            "artifact_reference"
          ]
        },
        "availability": {
          "enum": [
            "available",
            "reference_only",
            "unavailable"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_id",
        "kind",
        "availability"
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "literal"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "entity"
            },
            "entity": {
              "$ref": "#/$defs/entity"
            }
          },
          "required": [
            "type",
            "entity"
          ]
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pending",
            "user_approved",
            "rejected"
          ]
        },
        "approved_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "approval_method": {
          "enum": [
            "none",
            "authenticated_ui",
            "verified_host_attestation"
          ]
        }
      },
      "required": [
        "status",
        "approved_at",
        "approval_method"
      ]
    }
  }
}
