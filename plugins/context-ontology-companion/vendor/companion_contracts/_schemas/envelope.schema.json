{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ontology-companion-contracts:0.1.0-draft.1:envelope",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "0.1.0-draft.1"
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "enum": [
        "context-decision",
        "code-reference"
      ]
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?:[^\\s\\x00-\\x1f\\x7f]+)$(?![\\s\\S])"
    },
    "producer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^(?:[^\\s\\x00-\\x1f\\x7f]+)$(?![\\s\\S])"
          },
          "origin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "enum": [
              "user_asserted",
              "source_observed",
              "model_inferred"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^(?:[^\\s\\x00-\\x1f\\x7f]+)$(?![\\s\\S])"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "code": {
            "type": "object",
            "properties": {
              "basis": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "enum": [
                  "direct_syntax",
                  "resolved_static",
                  "framework_semantic",
                  "name_heuristic"
                ]
              },
              "rule_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(?:[a-z][a-z0-9_.-]{2,79})$(?![\\s\\S])"
              },
              "runtime_status": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "enum": [
                  "not_applicable",
                  "runtime_unknown"
                ]
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "minItems": 0,
                "maxItems": 1000
              }
            },
            "required": [
              "basis",
              "rule_id",
              "runtime_status",
              "limitations"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "origin",
          "scope",
          "locator"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "contract_version",
    "profile",
    "artifact_id",
    "producer",
    "evidence",
    "payload"
  ],
  "additionalProperties": false
}
