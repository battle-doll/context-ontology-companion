{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ontology-companion-contracts:0.1.0-draft.1:context-decision",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?:[^\\s\\x00-\\x1f\\x7f]+)$(?![\\s\\S])"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^(?:[^\\s\\x00-\\x1f\\x7f]+)$(?![\\s\\S])"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "enum": [
              "decision",
              "requirement",
              "constraint"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "origin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "enum": [
              "user_asserted",
              "source_observed",
              "model_inferred"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^(?:[^\\s\\x00-\\x1f\\x7f]+)$(?![\\s\\S])"
            },
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "valid_from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "valid_until": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32
          },
          "recorded_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "required": [
          "id",
          "statement",
          "origin",
          "evidence_refs",
          "valid_from",
          "valid_until",
          "recorded_at"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "scope",
    "decisions"
  ],
  "additionalProperties": false
}
